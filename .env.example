# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored — your secrets stay on the server / your machine.
#
# ─── Django ────────────────────────────────────────────────────────────────
# DJANGO_SECRET_KEY=<generate a long random string>
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=i-jcsa.com,www.i-jcsa.com,jcsajournal.com,www.jcsajournal.com
# BASE_URL=https://www.i-jcsa.com
# DATABASE_URL=postgres://journal:<password>@127.0.0.1:5432/journal

# ─── Email (sent FROM the journal address) ─────────────────────────────────
# Emails (submission confirmation, approval/rejection, review invitations and
# deadline reminders) are sent from EMAIL_HOST_USER using Gmail SMTP.
EMAIL_HOST_USER=instructorhttcjcsa@gmail.com
# Gmail does NOT accept your normal password here. Create an APP PASSWORD:
#   Google Account -> Security -> 2-Step Verification (must be ON)
#   -> App passwords -> create one for "Mail"
# Paste that 16-character app password below.
EMAIL_HOST_PASSWORD=

# ─── MTN MoMo (paid access to full published articles) ────────────────────
# Only needed when you go live with online payments. Without these the site
# falls back to manual confirmation (admin marks purchases as paid).
# Get sandbox keys free at https://momodeveloper.mtn.com (live requires a
# business application to MTN).
# MOMO_API_USER=
# MOMO_API_KEY=
# MOMO_SUBSCRIPTION_KEY=
# MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# MOMO_TARGET_ENVIRONMENT=sandbox
# MOMO_CALLBACK_URL=https://www.i-jcsa.com/articles/payment/callback/

# ─── Orange Money (second payment option) ─────────────────────────────────
# Merchant-only API (https://developer.orange.com/apis/om-webpay). Approve as
# an Orange Money merchant first; Orange sends you the integration document
# with your exact client_id / client_secret / merchant_key. Without them the
# site shows manual Orange Money instructions + editor confirmation.
# ORANGE_CLIENT_ID=
# ORANGE_CLIENT_SECRET=
# ORANGE_MERCHANT_KEY=
# ORANGE_BASE_URL=https://api.orange.com
# ORANGE_COUNTRY_CODE=cm
# ORANGE_NOTIF_URL=https://www.i-jcsa.com/articles/payment/orange/notif/

# ─── Journal manager payment receivers ────────────────────────────────────
# The mobile-money accounts that receive reader payments and journal fees.
# (Set these to the journal manager's real numbers if they differ.)
# PAYMENT_MTN_NUMBER=678391473
# PAYMENT_ORANGE_NUMBER=699462394
